# ============================================
# GIT IGNORE - files Git should NEVER track
# ============================================
# "git add ." tells Git to stage EVERYTHING.
# Some files don't belong in history. This list tells Git what to skip.

# --- Operating system junk (Windows / macOS / Linux) ---
# These are auto-generated by the OS. Committing them creates noise.
Thumbs.db
desktop.ini
.DS_Store

# --- Secrets: NEVER commit these ---
# API keys in git history = hacked accounts. Even after "deleting" them,
# they stay readable in old commits forever. History cannot be undone easily.
.env
*.key

# --- Editor / tool folders ---
.vscode/settings.json   # personal machine settings stay personal

# --- Dependencies (if you start using npm later) ---
# Thousands of files that can be re-downloaded with "npm install".
node_modules/

# --- Logs and temp files ---
*.log
*.tmp
